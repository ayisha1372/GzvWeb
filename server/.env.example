# Copy this file to .env and fill in your own values before running the server.

# Port the API + website will run on
PORT=4000

# Secret used to sign admin login tokens - change this to a long random string
JWT_SECRET=change-this-to-a-long-random-string

# Initial admin account (created automatically the first time the server runs)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Comma separated list of origins allowed to call the API.
# Use "*" while developing locally.
CORS_ORIGIN=*
